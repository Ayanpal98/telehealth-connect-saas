rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data;
    }

    function isAdmin() {
      return signedIn() && profile(request.auth.uid).role == 'admin';
    }

    function isClinician() {
      return signedIn() && profile(request.auth.uid).role == 'clinician';
    }

    match /profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Client-created profiles can only be patient profiles.
      // Clinician/admin profiles must be provisioned by an administrator/server process.
      allow create: if isSelf(uid) &&
        request.resource.data.role == 'patient';
      allow update: if isAdmin() ||
        (isSelf(uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasNone([
           'role',
           'verificationStatus',
           'verificationSource',
           'registrationNumber'
         ]));
      allow delete: if isAdmin();
    }

    match /cases/{caseId} {
      allow create: if signedIn() &&
        request.resource.data.patientId == request.auth.uid;

      // Production clinician access is assignment-based. Pending cases must be
      // assigned by a trusted server/admin workflow before a clinician can read them.
      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid ||
         resource.data.assignedConsultantId == request.auth.uid ||
         isAdmin());

      allow update: if isAdmin() ||
        (signedIn() &&
         resource.data.patientId == request.auth.uid &&
         request.resource.data.patientId == resource.data.patientId &&
         request.resource.data.assignedConsultantId == resource.data.assignedConsultantId) ||
        (signedIn() &&
         resource.data.assignedConsultantId == request.auth.uid &&
         request.resource.data.patientId == resource.data.patientId &&
         request.resource.data.assignedConsultantId == resource.data.assignedConsultantId);

      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.performedBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
