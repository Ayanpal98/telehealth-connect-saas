rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profile(uid) {
      return get(/databases/$(database)/documents/profiles/$(uid)).data;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile() && profile(request.auth.uid).role == 'admin';
    }

    function isClinician() {
      return hasProfile() && profile(request.auth.uid).role == 'clinician';
    }

    function isPatient() {
      return hasProfile() && profile(request.auth.uid).role == 'patient';
    }

    function validOwnPatientProfile() {
      return isPatient() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'patient' &&
        request.resource.data.email == request.auth.token.email;
    }

    function hasCaseAssignment(caseId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/caseAssignments/$(caseId + "_" + request.auth.uid));
    }

    match /profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && validOwnPatientProfile();
      allow update: if isAdmin() ||
        (isSelf(uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasNone([
           'role',
           'verificationStatus',
           'verificationSource',
           'registrationNumber'
         ]));
      allow delete: if isAdmin();
    }

    match /cases/{caseId} {
      allow create: if isPatient() &&
        request.resource.data.patientId == request.auth.uid;

      allow read: if signedIn() &&
        (resource.data.patientId == request.auth.uid ||
         resource.data.assignedConsultantId == request.auth.uid ||
         hasCaseAssignment(caseId) ||
         isAdmin());

      allow update: if isAdmin() ||
        (signedIn() &&
         resource.data.patientId == request.auth.uid &&
         request.resource.data.patientId == resource.data.patientId &&
         request.resource.data.assignedConsultantId == resource.data.assignedConsultantId) ||
        (isClinician() &&
         hasCaseAssignment(caseId) &&
         request.resource.data.patientId == resource.data.patientId);

      allow delete: if isAdmin();
    }

    match /caseAssignments/{assignmentId} {
      allow read: if signedIn() &&
        (resource.data.clinicianId == request.auth.uid ||
         resource.data.patientId == request.auth.uid ||
         isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /clinicianNotifications/{notificationId} {
      allow read: if signedIn() &&
        (resource.data.clinicianId == request.auth.uid || isAdmin());
      allow update: if signedIn() &&
        resource.data.clinicianId == request.auth.uid;
      allow create, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if hasProfile() &&
        request.resource.data.performedBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
